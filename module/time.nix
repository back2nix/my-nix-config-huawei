# ВРЕМЯ УЗЛА: chrony вместо systemd-timesyncd
#
# ЧТО БЫЛО ДО. В репозитории не было ни одной строки про синхронизацию времени
# (ни services.chrony, ни services.ntp, ни services.timesyncd.*, ни
# networking.timeServers) — только time.timeZone в configuration.nix. Работал
# дефолт NixOS: systemd-timesyncd с `FallbackNTP=0..3.nixos.pool.ntp.org`. Часы
# он синхронизирует, но по устройству это SNTP-клиент, а не NTP-клиент, и у
# него три структурных ограничения:
#
#   1) ОДИН СЕРВЕР ЗА РАЗ. Отбора по большинству нет в принципе: timesyncd
#      верит тому серверу, с которым разговаривает сейчас. Falseticker —
#      сломанный или подменённый источник — принимается без возражений. Именно
#      от этого защищает алгоритм отбора chrony (см. minsources ниже).
#   2) POLL ДО 34 МИНУТ. Между обновлениями ядро наращивает верхнюю оценку
#      ошибки `maxerror` со скоростью 500 ppm, то есть ~500 мкс на секунду
#      простоя. 2048 s без апдейта = оценка ошибки уезжает за 1 s.
#   3) НЕТ АУТЕНТИФИКАЦИИ. NTS timesyncd не поддерживает вообще — источник
#      времени принимается на веру от любого, кто успел ответить с нужного
#      адреса и порта. Для машины, которая регулярно ходит через чужие Wi-Fi,
#      это самый весомый пункт из трёх.
#
# ПОЧЕМУ ЭТО НЕ КОСМЕТИКА ИМЕННО ЗДЕСЬ. На машине живут k3s (ротация клиентских
# сертификатов и TLS apiserver), docker/containerd, sops-age и TOTP/JWT в
# браузере, плюс VPN-туннели с проверкой сроков сертификатов. Уход часов ломает
# всё это МЕДЛЕННО И НЕЗАМЕТНО, а диагностируется время в последнюю очередь.
#
# ☢️ ТАЙМЗОНА ЗДЕСЬ НЕ ЗАДАЁТСЯ. На сервере уместен явный UTC, но это рабочий
# ноутбук: `time.timeZone = "Europe/Moscow"` остаётся в configuration.nix, где
# и должен быть — часы на панели показывают местное время.
{config, ...}: {
  services.chrony = {
    # Модуль nixpkgs сам делает `services.timesyncd.enable = mkForce false` и
    # прописывает chronyd.service в `Conflicts=systemd-timesyncd.service`, а
    # также SYSTEMD_TIMEDATED_NTP_SERVICES=chronyd.service, чтобы
    # `timedatectl set-ntp` управлял именно chrony. Отдельно глушить timesyncd
    # НЕ НУЖНО и вредно — получится два источника правды.
    enable = true;

    # ☢️ СПИСОК ИСТОЧНИКОВ ЗАДАН В extraConfig, А НЕ ЗДЕСЬ — ЭТО НАМЕРЕННО.
    # Генератор модуля (nixos/modules/services/networking/ntp/chrony.nix)
    # клеит строку как `<pool|server> <host> <serverOption>[ nts]`, где
    # `serverOption` и флаг `nts` — ГЛОБАЛЬНЫЕ на весь список. Выразить
    # смешанный набор (NTS-серверы + неаутентифицированный пул как резерв) он
    # физически не может, равно как и per-source `minpoll/maxpoll/maxsources`.
    # Пустой список = модуль не генерирует ни одной строки источника; всё
    # ниже. `initstepslew` тоже отключается сам при пустом списке.
    servers = [];

    # Единственное, что даёт этот флаг при пустом `servers`, — директива
    # `ntsdumpdir /var/lib/chrony`: сохранение NTS-cookies между рестартами,
    # чтобы после каждого рестарта не проходить NTS-KE (TLS-хендшейк) заново.
    # Для ноутбука, который выключается по нескольку раз в день, это заметно.
    # Строки `nts` у источников проставлены вручную ниже.
    enableNTS = true;

    # ☢️ ЗДЕСЬ, В ОТЛИЧИЕ ОТ СЕРВЕРНОГО КОНФИГА, ОСТАВЛЕН ДЕФОЛТ `true`
    # (`rtcfile` + `rtcautotrim`), А НЕ `rtcsync`. Разница по существу:
    # rtcautotrim — режим для машины, которая ПОДОЛГУ ЖИВЁТ БЕЗ СЕТИ и на
    # старте опирается на RTC: chronyd измеряет собственный дрейф аппаратных
    # часов, копит его в /var/lib/chrony/chrony.rtc и на следующей загрузке
    # выставляет системное время С УЧЁТОМ НАКОПЛЕННОГО ДРЕЙФА — то есть с
    # точностью до долей секунды ещё до первого сетевого пакета. Это ровно
    # сценарий ноутбука: закрыл крышку в одном месте, открыл в другом, сети
    # пока нет. На VPS с постоянным аплинком смысла в этом нет, там правильнее
    # `rtcsync`; здесь — наоборот.
    # ☢️ Два режима ВЗАИМОИСКЛЮЧАЮЩИ: rtcautotrim + rtcsync = chronyd не
    # стартует, в модуле на это есть явный assert. Не добавлять `rtcsync` в
    # extraConfig ниже.
    enableRTCTrimming = true;

    makestep = {
      # ХОЛОДНЫЙ СТАРТ. Обычный режим chrony — плавный подгон частотой (slew),
      # он никогда не двигает часы назад и потому безопасен для журналов, TTL
      # и локального k3s. Но на старте машина может приехать с часами,
      # уехавшими на минуты (севшая батарейка RTC, долгий сон, снятая
      # блокировка BIOS), и slew выбирал бы эту разницу часами. makestep
      # разрешает СКАЧОК.
      enable = true;
      # Порог 1 с, а не дефолтные модулем 0.1 с: 0.1 с — это уровень обычного
      # сетевого джиттера, на нём скачки происходили бы штатно и регулярно.
      # 1.0/3 — эталонная пара из примеров самого chrony.
      threshold = 1.0;
      # ☢️ ТОЛЬКО ПЕРВЫЕ 3 ОБНОВЛЕНИЯ. Дальше chronyd переходит на slew
      # НАВСЕГДА (до рестарта). Это защита от «часы прыгают назад под
      # работающим k3s/kine и Postgres в контейнерах»: скачки живут только в
      # первые секунды после старта демона.
      # НЕ ставить сюда -1 (бесконечно): выход из suspend это НЕ чинит (см.
      # ниже про systemd.services.chrony-resume), а прыжок в прошлое под
      # нагруженной машиной разрешает.
      limit = 3;
    };

    extraConfig = ''
      #######################################################################
      # ИСТОЧНИКИ. Три независимых оператора с NTS + пул как резерв.
      #
      # ЗАЧЕМ НЕСКОЛЬКО НЕЗАВИСИМЫХ. Алгоритм отбора chrony строит пересечение
      # интервалов [offset−dispersion, offset+dispersion] всех источников и
      # отбрасывает тех, кто в большинство не попал (falseticker). Чтобы
      # большинство существовало, источников должно быть ≥3, а чтобы пережить
      # одного вруна — ≥4. Ниже 4 NTS-источника + до 3 из пула.
      #
      # ЗАЧЕМ ОПЕРАТОРЫ РАЗНЫЕ. Два адреса одного оператора (или два узла
      # одного пула) выходят из строя и врут ВМЕСТЕ — это один источник,
      # записанный дважды. Cloudflare (anycast), Netnod (шведский
      # национальный метрологический институт) и PTB (немецкий) не связаны
      # ни инфраструктурно, ни административно.
      #
      # minpoll 6 / maxpoll 7 — ИНТЕРВАЛ ОПРОСА 64…128 с (2^6…2^7).
      # Это прямой ответ на пункт (2) в шапке: верхняя оценка ошибки ядра —
      # это 500 мкс/с × интервал. Дефолт chrony (maxpoll 10, 1024 с) даёт
      # пилу с пиком ~0.5 с, дефолт timesyncd (до 2048 с) — свыше 1 с. При
      # maxpoll 7 пик ≈ 64 мс. Плата — один UDP-пакет на источник раз в
      # ~2 минуты; на энергопотребление ноутбука это не влияет (Wi-Fi и так
      # не спит, пока машина не ушла в suspend, а в suspend chronyd молчит).
      #######################################################################

      # NTS (аутентифицированные). Требуют исходящий tcp/4460 для NTS-KE.
      server time.cloudflare.com iburst nts minpoll 6 maxpoll 7
      server nts.netnod.se       iburst nts minpoll 6 maxpoll 7
      server ptbtime1.ptb.de     iburst nts minpoll 6 maxpoll 7
      server ptbtime2.ptb.de     iburst nts minpoll 6 maxpoll 7

      # РЕЗЕРВ БЕЗ АУТЕНТИФИКАЦИИ — тот самый пул, на котором машина жила до
      # сих пор (дефолт timesyncd). Он существует ради ДВУХ вещей:
      #   * разрыв «курицы и яйца» на холодном старте: NTS-KE — это TLS, а TLS
      #     проверяет СРОК ДЕЙСТВИЯ сертификата. Если часы уехали далеко,
      #     NTS-KE не пройдёт, и машина без резерва осталась бы вообще без
      #     времени. Пул подтянет часы (makestep), после чего NTS поднимется
      #     сам. Альтернатива `nocerttimecheck` отвергнута: она ослабляет
      #     проверку постоянно, а не только на старте;
      #   * деградация вместо отказа, если tcp/4460 где-то по пути режется —
      #     а на публичных и корпоративных Wi-Fi режется регулярно.
      # maxsources 3 — не тянуть из пула больше, чем нужно для кворума.
      pool 2.nixos.pool.ntp.org iburst maxsources 3 minpoll 6 maxpoll 7

      # ☢️ КАК СМЕШЕНИЕ АУТЕНТИФИЦИРОВАННЫХ И НЕТ НЕ ПРЕВРАЩАЕТСЯ В ДЫРУ.
      # Без этой строки chrony (authselectmode mix по умолчанию) считает
      # голоса всех источников одинаково, и атакующий на сетевом пути (то есть
      # владелец любой чужой точки доступа) мог бы перевесить NTS-серверы
      # подделанными ответами пула — то есть NTS не давал бы НИЧЕГО.
      # `prefer` = если есть хотя бы один пригодный аутентифицированный
      # источник, неаутентифицированные в отборе НЕ УЧАСТВУЮТ вовсе; пул
      # оживает только когда NTS недоступен целиком.
      # ☢️ НЕ МЕНЯТЬ НА `require`: там при недоступности NTS часы просто
      # перестают синхронизироваться — тихо, без единой ошибки в journal.
      # Осознанный размен: доступность времени важнее, чем гарантия
      # аутентичности КАЖДОГО обновления.
      authselectmode prefer

      # Не трогать часы, пока не согласились как минимум два источника.
      # Дешёвая страховка от одиночного falseticker'а на старте, когда
      # интервалы ещё широкие и отбор по большинству не успел устояться.
      # Выше 2 не поднимаем: 3+ заметно задерживает первую синхронизацию, а на
      # ноутбуке «первая синхронизация» случается по нескольку раз в день.
      minsources 2

      # Секунда координации берётся из tz-базы (right/UTC содержит таблицу
      # високосных секунд), а не только из бита в NTP-пакете: машина знает о
      # предстоящей leap second ЗАРАНЕЕ и не зависит от того, выставил ли
      # конкретный сервер флаг. Обработка — по умолчанию `leapsecmode system`,
      # то есть скачок передаётся ядру.
      # ⚠️ Требует наличия right/UTC в tzdata — в nixpkgs он есть
      # (/etc/zoneinfo/right/UTC). Если каталог right/ когда-нибудь пропадёт,
      # chronyd напишет ошибку в journal и продолжит без leapsectz.
      leapsectz right/UTC

      # ☢️ НЕ БЫТЬ NTP-СЕРВЕРОМ. По умолчанию chronyd открывает udp/123 на
      # приём (пусть и не отвечая никому без `allow`) — на машине, которая
      # цепляется к чужим сетям, это лишний слушающий сокет. `port 0`
      # выключает серверный сокет целиком; клиентские запросы уходят с
      # эфемерных портов и работают как ни в чём не бывало.
      # Если когда-нибудь понадобится раздавать время подам локального k3s —
      # это осознанная правка с `allow 10.42.0.0/16` и открытием ВХОДЯЩЕГО
      # udp/123 в networking.firewall.
      port 0

      # cmdport (udp/323) НАМЕРЕННО ОСТАВЛЕН ПО УМОЛЧАНИЮ: chronyd слушает его
      # только на 127.0.0.1/::1, наружу он не виден, а `chronyc sources -v` /
      # `chronyc tracking` — единственный способ увидеть, что происходит с
      # временем.

      # Громко писать в journal каждую коррекцию больше 0.5 с. Без этого
      # единичный крупный скачок (сон, севший RTC, соврал источник) не
      # оставляет следа нигде, и разбирать его потом не по чему.
      logchange 0.5
    '';
  };

  # ВЫХОД ИЗ SUSPEND/HIBERNATE. Специфика именно ноутбука, на сервере этого
  # блока нет. После пробуждения системные часы отстают ровно на длительность
  # сна (ядро подтягивает их из RTC, но RTC успел уплыть), а лимит makestep к
  # этому моменту давно исчерпан — chronyd будет выбирать разницу медленным
  # slew'ом часами, и всё это время `date` врёт.
  # `chronyc -a makestep` заставляет шагнуть один раз, здесь и сейчас, не
  # трогая политику makestep для штатной работы. `-a` — авторизация через
  # unix-сокет /run/chrony/chronyd.sock (доступен root), пароля не требует.
  # `onlinestatus`/`burst` тут не нужны: сеть после resume поднимается
  # асинхронно, а chronyd сам опрашивает источники раз в 64 с.
  systemd.services.chrony-resume = {
    description = "Step the clock with chrony after resume";
    wantedBy = ["post-resume.target"];
    after = ["post-resume.target" "chronyd.service"];
    serviceConfig = {
      Type = "oneshot";
      # Префикс `-` (а не `|| true`: ExecStart исполняется БЕЗ шелла, `||`
      # уехал бы в argv) — пробуждение НЕ должно падать из-за времени: если
      # chronyd ещё не дожил до готовности сокета, следующий штатный опрос всё
      # равно всё выправит, просто медленнее.
      ExecStart = "-${config.services.chrony.package}/bin/chronyc -a makestep";
    };
  };
}
